---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Locale, isRTL, getTranslations, getBodyFont, getHeadingFont } from '../i18n';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  canonicalPath?: string;
}

const { title, description, locale, canonicalPath = '' } = Astro.props;
const rtl = isRTL(locale);
const dir = rtl ? 'rtl' : 'ltr';
const site = 'https://www.kadaradiator.com';
const canonical = `${site}/${locale}${canonicalPath}`;
const bodyFont = getBodyFont(locale);
const headingFont = getHeadingFont(locale);

const isHomepage = canonicalPath === '';
const ogLocale = locale === 'tr' ? 'tr_TR' : locale === 'en' ? 'en_US' : 'ar_AR';
---

<!doctype html>
<html lang={locale} dir={dir} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <title>{title}</title>
    {isHomepage && (
      <link rel="preload" as="image" href="/kaynak.avif" imagesizes="(max-width: 768px) 100vw, 50vw" />
    )}

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Hreflang -->
    <link rel="alternate" hreflang="tr" href={`${site}/tr${canonicalPath}`} />
    <link rel="alternate" hreflang="en" href={`${site}/en${canonicalPath}`} />
    <link rel="alternate" hreflang="ar" href={`${site}/ar${canonicalPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/tr${canonicalPath}`} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%23006837'/><g fill='%23FFFFFF'><rect x='7' y='7' width='4' height='18' rx='1'/><path d='M14 14 L21 7 L25 7 L18 14 Z'/><path d='M17 13 L25 25 L21 25 L13 15 Z'/></g></svg>" />

    {isHomepage && (
      <script type="application/ld+json" set:html={`{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "KADA Oto Radyatör",
  "foundingDate": "1983",
  "telephone": "+902126579770",
  "email": "info@kadaradiator.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "1438. Sk. No:28",
    "addressLocality": "Bağcılar",
    "addressRegion": "İstanbul",
    "addressCountry": "TR"
  },
  "url": "https://www.kadaradiator.com",
  "sameAs": []
}`} />
    )}

    <style define:vars={{ bodyFont, headingFont }}>
      body { font-family: var(--bodyFont), sans-serif; }
      h1, h2, h3, h4, h5, h6 { font-family: var(--headingFont), sans-serif; }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-cream text-dark-bg antialiased">
    <Header locale={locale} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />

    <!-- WhatsApp Floating Button -->
    <a
      href="https://wa.me/905302537010?text=Merhaba%2C%20KADA%20Radyat%C3%B6r%20hakk%C4%B1nda%20bilgi%20almak%20istiyorum."
      target="_blank"
      rel="noopener noreferrer"
      class="fixed bottom-6 right-6 z-50 w-14 h-14 bg-[#25D366] text-white rounded-full flex items-center justify-center shadow-lg hover:scale-110 transition-transform duration-200"
      aria-label="WhatsApp"
    >
      <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12.031 21.61c-1.631 0-3.23-.44-4.631-1.27l-5.15 1.35 1.37-5.02a11.9 11.9 0 01-1.34-5.46C2.28 4.7 6.64.33 12.03.33a11.83 11.83 0 018.42 3.48 11.86 11.86 0 013.48 8.42c-.01 5.4-4.38 9.38-11.9 9.38zm-4.9-3.23l.3.18a9.89 9.89 0 004.6 1.13c4.4 0 8-3.59 8-8s-3.6-8-8-8-8 3.6-8 8c0 1.76.54 3.48 1.57 4.9l.21.32-.87 3.19 3.28-.86.01-.01zM17.15 14.5c-.27-.14-1.62-.8-1.87-.89-.25-.09-.43-.14-.62.14-.18.27-.71.89-.87 1.07-.16.18-.32.2-.59.07-.27-.14-1.16-.43-2.2-1.36-.81-.72-1.35-1.62-1.51-1.89-.16-.27-.02-.42.12-.55.12-.13.27-.32.41-.48.14-.16.18-.27.27-.45.09-.18.05-.34-.02-.48-.07-.14-.62-1.5-.85-2.05-.22-.54-.45-.47-.62-.48h-.53c-.18 0-.48.07-.73.34-.25.27-.96.94-.96 2.3s.98 2.67 1.12 2.85c.14.18 1.94 2.96 4.7 4.12.66.28 1.17.45 1.57.57.66.21 1.26.18 1.74.11.53-.08 1.62-.66 1.85-1.3.23-.64.23-1.19.16-1.3-.06-.11-.24-.18-.51-.31z" />
      </svg>
    </a>
    <!-- Mobile Language Switcher (Floating) -->
    <div class="md:hidden fixed bottom-6 left-6 z-50">
      <!-- Options Container -->
      <div 
        id="mobile-lang-options"
        class="absolute bottom-full left-0 mb-4 flex flex-col gap-3 transition-all duration-300 ease-out opacity-0 pointer-events-none translate-y-4"
      >
        <a href={`/tr${canonicalPath}`} class="w-12 h-12 bg-white border border-[#E0DDD7] rounded-full flex items-center justify-center text-[#0D6830] font-bold text-[13px] shadow-md hover:scale-110 transition-transform">TR</a>
        <a href={`/en${canonicalPath}`} class="w-12 h-12 bg-white border border-[#E0DDD7] rounded-full flex items-center justify-center text-[#0D6830] font-bold text-[13px] shadow-md hover:scale-110 transition-transform">EN</a>
        <a href={`/ar${canonicalPath}`} class="w-12 h-12 bg-white border border-[#E0DDD7] rounded-full flex items-center justify-center text-[#0D6830] font-bold text-[13px] shadow-md hover:scale-110 transition-transform">AR</a>
      </div>
      
      <!-- Main Toggle Button -->
      <button 
        id="mobile-lang-toggle"
        class="w-14 h-14 bg-white border-2 border-[#0D6830] rounded-full flex items-center justify-center text-[#0D6830] font-bold text-lg shadow-lg hover:scale-105 transition-transform"
        aria-label="Change Language"
      >
        {locale === 'tr' ? 'TR' : locale === 'en' ? 'EN' : 'AR'}
      </button>
    </div>

    <script>
      const toggle = document.getElementById('mobile-lang-toggle');
      const options = document.getElementById('mobile-lang-options');
      
      if (toggle && options) {
        toggle.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = !options.classList.contains('opacity-0');
          
          if (isOpen) {
            options.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
          } else {
            options.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
          }
        });

        document.addEventListener('click', (e) => {
          if (!options.contains(e.target as Node) && !toggle.contains(e.target as Node)) {
            options.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
          }
        });
      }
    </script>
  </body>
</html>
