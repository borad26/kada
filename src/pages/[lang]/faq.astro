---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Locale, getTranslations, localizedPath } from '../../i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'tr' } },
    { params: { lang: 'en' } },
    { params: { lang: 'ar' } },
  ];
}

const { lang } = Astro.params;
const locale = lang as Locale;
const t = getTranslations(locale);
const delays = ['animate-delay-100', 'animate-delay-200', 'animate-delay-300', 'animate-delay-400'];
---

<BaseLayout
  title={t.faq.pageTitle}
  description={t.faq.pageDescription}
  locale={locale}
  canonicalPath="/faq"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": t.faq.items?.map((item: any) => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.answer
        }
      })) || []
    })} />
  </Fragment>

  <!-- Page Content Wrapper -->
  <div class="bg-cream">
    <!-- Page Header -->
    <section class="pt-16 md:pt-24 pb-8 md:pb-12 relative overflow-hidden">
      <div class="absolute bottom-0 right-0 w-72 h-72 bg-primary/5 rounded-full blur-3xl translate-y-1/3 translate-x-1/3"></div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading text-dark-bg mb-4 animate-fade-in-up">{t.faq.heading}</h1>
        <p class="text-muted text-base md:text-lg max-w-2xl mx-auto animate-fade-in-up animate-delay-100">{t.faq.subheading}</p>
      </div>
    </section>

    <!-- FAQ Accordion -->
    <section class="pt-8 md:pt-12 pb-16 md:pb-24">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="space-y-4" id="faq-accordion">
          {t.faq.items.map((item, i) => (
            <div
              class:list={['bg-white border border-[rgba(13,104,48,0.08)] shadow-sm rounded-xl overflow-hidden animate-fade-in-up', delays[i % 4] || '']}
              data-faq-item
            >
              <button
              class="w-full flex items-center justify-between px-6 py-5 text-start group"
              data-faq-toggle
              aria-expanded="false"
              id={`faq-toggle-${i}`}
            >
              <span class="text-dark-bg font-medium text-sm md:text-base pe-4 font-body">{item.question}</span>
              <svg
                class="w-5 h-5 text-muted shrink-0 transition-transform duration-300 group-aria-expanded:rotate-180"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                data-faq-chevron
              >
                <path d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="hidden px-6 pb-5" data-faq-content>
              <p class="text-muted text-sm leading-relaxed">{item.answer}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>
</div>

  <!-- Dark CTA Section -->
  <section class="py-16 md:py-24 bg-[#1A1E1B] text-center border-t border-[rgba(255,255,255,0.05)]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-heading text-[#ECECEC] mb-4">{t.faq.cta.title}</h2>
      <p class="text-lg text-[#8A9490] mb-8">{t.faq.cta.subtitle}</p>
      <a
        href={localizedPath('/contact', locale)}
        class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-primary hover:bg-primary-dark text-white font-bold rounded-xl transition-all duration-300 hover:-translate-y-1 shadow-lg shadow-primary/20"
      >
        {t.faq.cta.button}
      </a>
    </div>
  </section>

  
</BaseLayout>

<script>
  // FAQ accordion functionality
  document.querySelectorAll('[data-faq-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('[data-faq-item]');
      const content = item?.querySelector('[data-faq-content]');
      const isOpen = btn.getAttribute('aria-expanded') === 'true';

      // Close all others
      document.querySelectorAll('[data-faq-item]').forEach((otherItem) => {
        const otherBtn = otherItem.querySelector('[data-faq-toggle]');
        const otherContent = otherItem.querySelector('[data-faq-content]');
        otherBtn?.setAttribute('aria-expanded', 'false');
        otherContent?.classList.add('hidden');
      });

      // Toggle current
      if (!isOpen) {
        btn.setAttribute('aria-expanded', 'true');
        content?.classList.remove('hidden');
      }
    });
  });
</script>
