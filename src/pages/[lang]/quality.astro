---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Locale, getTranslations } from '../../i18n';
import SimpleCTA from '../../components/SimpleCTA.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'tr' } },
    { params: { lang: 'en' } },
    { params: { lang: 'ar' } },
  ];
}

const { lang } = Astro.params;
const locale = lang as Locale;
const t = getTranslations(locale);

const delays = ['animate-delay-100', 'animate-delay-200', 'animate-delay-300'];

const tests = [
  { ...t.quality.testingSection.pressure, id: 'pressure' },
  { ...t.quality.testingSection.leak, id: 'leak' },
  { ...t.quality.testingSection.thermal, id: 'thermal' }
];

const importanceStats = [
  t.quality.importanceSection.stat1,
  t.quality.importanceSection.stat2,
  t.quality.importanceSection.stat3
];
---

<BaseLayout
  title={t.quality.pageTitle}
  description={t.quality.pageDescription}
  locale={locale}
  canonicalPath="/quality"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": t.quality.faqSection?.items?.map((item: any) => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.answer
        }
      })) || []
    })} />
  </Fragment>

<div class="bg-cream min-h-screen">
  <!-- SECTION 1: Page Header -->
  <section class="py-16 md:py-24 relative overflow-hidden">
    <div class="absolute top-0 right-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl -translate-y-1/3 translate-x-1/3"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading text-dark-bg mb-4 animate-fade-in-up">{t.quality.heading}</h1>
      <p class="text-muted text-base md:text-lg max-w-2xl mx-auto animate-fade-in-up animate-delay-100">{t.quality.subheading}</p>
    </div>
  </section>

  <!-- SECTION 2: ISO Sertifikası -->
  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-[#1A1E1B] rounded-3xl p-10 md:p-16 shadow-lg">
        <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20">
        <!-- Left: Text -->
        <div class="flex-1 animate-fade-in-up">
          <div class="inline-flex items-center px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold tracking-wider mb-6">
            {t.quality.isoSection.label}
          </div>
          <h2 class="text-5xl md:text-6xl font-heading text-[#ECECEC] mb-8">{t.quality.isoSection.heading}</h2>
          <div class="space-y-6 text-[#8A9490] text-lg leading-relaxed mb-8">
            <p>{t.quality.isoSection.p1}</p>
            <p>{t.quality.isoSection.p2}</p>
            <p>{t.quality.isoSection.p3}</p>
          </div>

          <div class="flex gap-3 flex-wrap">
            <a href="/KADA-ISO9001-2015-TR.pdf" target="_blank" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-[#0D6830] text-[#0D6830] hover:bg-[#0D6830] hover:text-white transition-colors text-sm font-medium">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
              {t.quality.isoSection.certTr}
            </a>
            <a href="/KADA-ISO9001-2015-EN.pdf" target="_blank" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-[#0D6830] text-[#0D6830] hover:bg-[#0D6830] hover:text-white transition-colors text-sm font-medium">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
              {t.quality.isoSection.certEn}
            </a>
            <a href="/KADA-ISO9001-2015-IQNet.pdf" target="_blank" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-[#0D6830] text-[#0D6830] hover:bg-[#0D6830] hover:text-white transition-colors text-sm font-medium">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
              {t.quality.isoSection.certIq}
            </a>
          </div>
        </div>

        <!-- Right: Badge Visual -->
        <div class="flex-1 w-full max-w-md mx-auto animate-fade-in-up animate-delay-200">
          <div class="bg-[#232824] border border-[rgba(255,255,255,0.07)] rounded-3xl p-10 md:p-14 text-center relative overflow-hidden">
            <div class="absolute top-0 right-0 w-64 h-64 bg-[#0D6830]/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
            
            <div class="relative z-10">
              <!-- Shield Icon -->
              <div class="w-24 h-24 mx-auto text-[#0D6830] mb-8">
                <svg fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10zm0-12a2 2 0 110-4 2 2 0 010 4z" />
                </svg>
              </div>
              
              <h3 class="font-heading text-4xl text-[#0D6830] mb-2">{t.quality.isoSection.badgeTitle}</h3>
              <p class="font-mono text-sm text-[#8A9490] tracking-widest uppercase mb-8">{t.quality.isoSection.badgeSubtitle}</p>
              
              <div class="flex items-center justify-center gap-3 pt-8 border-t border-[rgba(255,255,255,0.07)]">
                <svg class="w-5 h-5 text-[#0D6830]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-[#ECECEC] text-sm font-medium">{t.quality.isoSection.badgeText}</span>
              </div>
            </div>
          </div>
        </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: Test Süreçlerimiz -->
  <section class="py-20 md:py-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-5xl md:text-6xl font-heading text-dark-bg text-center mb-16 md:mb-24">{t.quality.testingSection.title}</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {tests.map((test, i) => (
          <div class:list={['bg-[#FFFFFF] border border-[#E0DDD7] rounded-3xl p-8 md:p-10 flex flex-col hover:shadow-xl hover:-translate-y-2 transition-all duration-300 animate-fade-in-up', delays[i] || '']}>
            
            <div class="w-[72px] h-[72px] bg-[#0D6830] rounded-full flex items-center justify-center mb-8 shadow-lg shadow-[#0D6830]/20 shrink-0">
              {test.id === 'pressure' && (
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 22a10 10 0 100-20 10 10 0 000 20z M12 16v-4 M12 8h.01 M16.24 7.76l-1.41 1.41 M7.76 16.24l1.41-1.41 M16.24 16.24l-1.41-1.41 M7.76 7.76l1.41 1.41" />
                </svg>
              )}
              {test.id === 'leak' && (
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 2.69l5.66 5.66a8 8 0 11-11.31 0z" />
                </svg>
              )}
              {test.id === 'thermal' && (
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
              )}
            </div>
            
            <h3 class="text-xl font-bold text-dark-bg mb-4 flex-none">{test.title}</h3>
            
            <p class="text-dark-mid/70 text-base leading-relaxed mb-10 grow">{test.description}</p>
            
            <div class="mt-auto pt-6 border-t border-[#E0DDD7]">
              <div class="flex items-center gap-3">
                <svg class="w-5 h-5 text-[#0D6830] shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span class="text-[#0D6830] font-semibold text-sm">{test.stat}</span>
              </div>
            </div>
            
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 4: Neden Önemli? -->
  <section class="py-12 md:py-16" id="quality-stats-strip">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-[#1A1E1B] rounded-3xl p-10 md:p-14 shadow-lg border border-[rgba(255,255,255,0.05)]">
        <h2 class="text-3xl md:text-4xl font-heading text-[#ECECEC] text-center mb-12">{t.quality.importanceSection.title}</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-[rgba(255,255,255,0.05)]">
        {importanceStats.map((stat, i) => (
          <div class:list={['flex flex-col items-center justify-center py-8 md:py-4 animate-fade-in-up', delays[i] || '']}>
            <span class="text-5xl md:text-6xl font-heading font-bold text-[#0D6830] leading-none mb-4 tracking-tight quality-stat-number" data-original={stat.value}>
              0
            </span>
            <span class="text-sm md:text-base font-medium text-[#8A9490] tracking-wide text-center px-4">
              {stat.label}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 5: FAQ Accordion -->
  <section class="py-16 md:py-24 mb-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-heading text-dark-bg text-center mb-12">{t.quality.faqSection.title}</h2>
      <div class="space-y-4" id="quality-faq-accordion">
        {t.quality.faqSection.items.map((item: any, i: number) => (
          <div class:list={['bg-white rounded-xl overflow-hidden shadow-sm animate-fade-in-up', delays[i % 3] || '']} data-faq-item>
            <button class="w-full flex items-center justify-between px-6 py-5 text-start group" data-faq-toggle aria-expanded="false" id={`quality-faq-toggle-${i}`}>
              <span class="text-dark-bg font-medium text-sm md:text-base pe-4 font-body">{item.question}</span>
              <svg class="w-5 h-5 text-muted shrink-0 transition-transform duration-300 group-aria-expanded:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" data-faq-chevron>
                <path d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="hidden px-6 pb-5" data-faq-content>
              <p class="text-muted text-sm leading-relaxed">{item.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</div>

  <!-- SECTION 6: Quote CTA -->
  <SimpleCTA locale={locale} />
</BaseLayout>

<script>
  document.querySelectorAll('[data-faq-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('[data-faq-item]');
      const content = item?.querySelector('[data-faq-content]');
      const isOpen = btn.getAttribute('aria-expanded') === 'true';

      document.querySelectorAll('[data-faq-item]').forEach((otherItem) => {
        const otherBtn = otherItem.querySelector('[data-faq-toggle]');
        const otherContent = otherItem.querySelector('[data-faq-content]');
        otherBtn?.setAttribute('aria-expanded', 'false');
        otherContent?.classList.add('hidden');
      });

      if (!isOpen) {
        btn.setAttribute('aria-expanded', 'true');
        content?.classList.remove('hidden');
      }
    });
  });

  // Stats Animation
  function animateQualityCountUp(el: HTMLElement) {
    const original = el.dataset.original;
    if (!original) return;
    
    const numMatch = original.match(/\d+/g);
    if (!numMatch) return;
    
    const target = parseInt(numMatch.join(''), 10);
    
    const prefixMatch = original.match(/^[^\d]+/);
    const prefix = prefixMatch ? prefixMatch[0] : '';
    
    const suffixMatch = original.match(/[^\d]+$/);
    const suffix = suffixMatch ? suffixMatch[0] : '';
    
    const duration = 2000;
    const startTime = performance.now();
    
    function update(now: number) {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = Math.round(eased * target);
      
      let text = current.toString();
      if (target >= 1000 && current >= 1000) {
        text = text.replace(/\B(?=(\d{3})+(?!\d))/g, ".");
      }
      
      if (progress < 1) {
        el.textContent = prefix + text + suffix;
        requestAnimationFrame(update);
      } else {
        el.textContent = original;
      }
    }
    
    requestAnimationFrame(update);
  }

  const qualityObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const numbers = entry.target.querySelectorAll<HTMLElement>('.quality-stat-number');
          numbers.forEach((el) => animateQualityCountUp(el));
          qualityObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  const statsStrip = document.getElementById('quality-stats-strip');
  if (statsStrip) {
    qualityObserver.observe(statsStrip);
  }
</script>
