---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Locale, getTranslations } from '../../i18n';
import { referencesTR, referencesEN, referencesAR } from '../../data/references';
import SimpleCTA from '../../components/SimpleCTA.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'tr' } },
    { params: { lang: 'en' } },
    { params: { lang: 'ar' } },
  ];
}

const { lang } = Astro.params;
const locale = lang as Locale;
const t = getTranslations(locale);

const references = locale === 'tr' ? referencesTR : locale === 'en' ? referencesEN : referencesAR;

// Get unique categories for the filter
const categories = [...new Set(references.map(r => r.category))];
---

<BaseLayout
  title={t.nav.references + ' | KADA Oto Radyatör'}
  description={t.site.description}
  locale={locale}
  canonicalPath="/referanslar"
>
  <!-- Hero Section -->
  <section class="py-16 md:py-24 bg-cream relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading text-dark-bg mb-4 animate-fade-in-up">{t.nav.references}</h1>
        <p class="text-lg text-dark-bg/80 animate-fade-in-up animate-delay-100">
          {locale === 'tr' ? 'Küresel iş ortaklarımız ve referanslarımızla sektördeki güçlü konumumuzu sürdürüyoruz.' : locale === 'en' ? 'We maintain our strong position in the sector with our global business partners and references.' : 'نحافظ على مكانتنا القوية في القطاع من خلال شركائنا وعملائنا العالميين.'}
        </p>
      </div>
    </div>
  </section>

  <!-- Filter and Grid Section -->
  <section class="py-16 md:py-24 bg-white relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Category Filter -->
      <div class="flex flex-wrap items-center justify-center gap-2 mb-12 animate-fade-in-up animate-delay-200">
        <button class="filter-btn active px-4 py-2 rounded-full border border-primary bg-primary text-white text-sm font-medium transition-colors" data-category="all">
          {locale === 'tr' ? 'Tümü' : locale === 'en' ? 'All' : 'الكل'}
        </button>
        {categories.map((cat) => (
          <button class="filter-btn px-4 py-2 rounded-full border border-border-light bg-white text-dark-bg hover:border-primary text-sm font-medium transition-colors" data-category={cat}>
            {cat}
          </button>
        ))}
      </div>

      <!-- References Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="references-grid">
        {references.map((ref, i) => (
          <div class="ref-card glass-card rounded-xl p-6 flex flex-col justify-between hover:border-primary/30 hover:shadow-lg transition-all duration-300 animate-fade-in-up bg-white border border-border-light" data-category={ref.category} style={`animation-delay: ${(i % 6) * 100}ms;`}>
            <div>
              <div class="inline-block px-3 py-1 bg-primary/10 text-primary text-xs font-bold uppercase tracking-wider rounded-md mb-4">
                {ref.category}
              </div>
              <h3 class="text-xl font-bold font-heading text-dark-bg mb-2 text-left rtl:text-right"><bdi dir="ltr">{ref.name}</bdi></h3>
            </div>
            
            <div class="flex items-center gap-2 text-muted text-sm mt-6 pt-4 border-t border-border-light">
              <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span class="text-left rtl:text-right flex-1"><bdi dir="ltr">{ref.location}</bdi></span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SimpleCTA />
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.ref-card');

    buttons.forEach(button => {
      button.addEventListener('click', () => {
        // Reset all buttons to inactive state
        buttons.forEach(b => {
          b.classList.remove('bg-primary', 'text-white', 'border-primary');
          b.classList.add('bg-white', 'text-dark-bg', 'border-border-light');
        });

        // Set clicked button to active state
        button.classList.remove('bg-white', 'text-dark-bg', 'border-border-light');
        button.classList.add('bg-primary', 'text-white', 'border-primary');

        const category = button.getAttribute('data-category');

        cards.forEach(card => {
          if (category === 'all' || card.getAttribute('data-category') === category) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  });
</script>
