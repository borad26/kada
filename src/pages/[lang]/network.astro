---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Locale, getTranslations, localizedPath } from '../../i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'tr' } },
    { params: { lang: 'en' } },
    { params: { lang: 'ar' } },
  ];
}

const { lang } = Astro.params;
const locale = lang as Locale;
const t = getTranslations(locale);
const networkExport = (t.network as any)['export'];
const regions = networkExport.regions;
const exportTitle = networkExport.title;
const exportDescription = networkExport.description;
const delays = ['animate-delay-100', 'animate-delay-200', 'animate-delay-300', 'animate-delay-400'];
---

<BaseLayout
  title={t.network.pageTitle}
  description={t.network.pageDescription}
  locale={locale}
  canonicalPath="/network"
>
  <!-- Page Header -->
  <section class="py-16 md:py-24 bg-cream relative overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading text-dark-bg mb-4 animate-fade-in-up">{t.network.heading}</h1>
      <p class="text-muted text-base md:text-lg max-w-2xl mx-auto animate-fade-in-up animate-delay-100">{t.network.subheading}</p>
    </div>
  </section>

  <!-- Domestic Network -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-5xl md:text-6xl font-heading text-dark-bg mb-6">{t.network.domestic.title}</h2>
          <p class="text-muted leading-relaxed text-base md:text-lg">{t.network.domestic.description}</p>
          <!-- Stats row -->
          <div class="flex gap-8 mt-8">
            <div class="glass-card rounded-xl px-6 py-4">
              <div class="text-2xl font-heading text-primary">300+</div>
              <div class="text-xs font-mono text-muted uppercase tracking-wider">{t.stats.dealers}</div>
            </div>
            <div class="glass-card rounded-xl px-6 py-4">
              <div class="text-2xl font-heading text-primary">81</div>
              <div class="text-xs font-mono text-muted uppercase tracking-wider">İl</div>
            </div>
          </div>
        </div>
        <!-- Map placeholder -->
        <div class="bg-cream rounded-2xl aspect-video flex items-center justify-center border border-border-light">
          <svg class="w-24 h-24 text-muted opacity-20" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
            <path d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- Export Markets -->
  <section class="py-16 md:py-24 bg-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-5xl md:text-6xl font-heading text-dark-bg text-center mb-6">{exportTitle}</h2>
      <p class="text-dark-mid text-opacity-70 text-base md:text-lg max-w-2xl mx-auto text-center mb-12">{exportDescription}</p>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {Object.entries(regions).map(([key, name], i) => (
          <div class:list={['bg-white rounded-2xl p-6 border border-border-light text-center hover:shadow-xl hover:shadow-primary/5 transition-all duration-300 hover:-translate-y-1 animate-fade-in-up', delays[i] || '']}>
            <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-dark-bg font-body">{name}</h3>
          </div>
        ))}
      </div>

      <!-- CTA -->
      <div class="text-center mt-12">
        <p class="text-dark-mid text-opacity-70 mb-6">{t.network.cta}</p>
        <a
          href={localizedPath('/contact', locale)}
          class="inline-flex items-center gap-2 px-8 py-3.5 bg-primary hover:bg-primary-dark text-white font-semibold rounded-xl transition-colors duration-200"
          id="network-contact-cta"
        >
          {t.nav.contact}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
