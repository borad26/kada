---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Locale, getTranslations, CATEGORY_KEYS } from '../../i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'tr' } },
    { params: { lang: 'en' } },
    { params: { lang: 'ar' } },
  ];
}

const { lang } = Astro.params;
const locale = lang as Locale;
const t = getTranslations(locale);
const categories = t.products.categories as Record<string, { name: string; description: string }>;
const subjects = Object.entries(t.contact.form.subjects);
const delays = ['animate-delay-100', 'animate-delay-200', 'animate-delay-300', 'animate-delay-400'];
---

<BaseLayout
  title={t.contact.pageTitle}
  description={t.contact.pageDescription}
  locale={locale}
  canonicalPath="/contact"
>
  <!-- Page Header -->
  <section class="pt-16 md:pt-24 pb-8 md:pb-10 bg-cream relative overflow-hidden">
    <div class="absolute top-1/3 right-0 w-80 h-80 bg-primary/5 rounded-full blur-3xl translate-x-1/2"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading text-dark-bg mb-4 animate-fade-in-up">{t.contact.heading}</h1>
      <p class="text-muted text-base md:text-lg max-w-2xl mx-auto animate-fade-in-up animate-delay-100">{t.contact.subheading}</p>
    </div>
  </section>

  <!-- Contact Content -->
  <section class="pb-16 md:pb-24 bg-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16">

        <!-- Contact Form (3 cols) -->
        <div class="lg:col-span-3">
          <form
            class="glass-card rounded-2xl p-6 md:p-8 space-y-5"
            id="contact-form"
            method="POST"
            data-sending-text={t.contact.form.sending}
          >
            <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <!-- Name -->
              <div>
                <label for="contact-name" class="block text-sm font-medium text-dark-bg mb-1.5">
                  {t.contact.form.name} <span class="text-primary">*</span>
                </label>
                <input
                  type="text" id="contact-name" name="name" required
                  class="w-full px-4 py-2.5 bg-white border border-border-light rounded-lg text-dark-bg text-sm placeholder-muted focus:border-primary focus:ring-1 focus:ring-primary transition-colors"
                />
              </div>

              <!-- Email -->
              <div>
                <label for="contact-email" class="block text-sm font-medium text-dark-bg mb-1.5">
                  {t.contact.form.email} <span class="text-primary">*</span>
                </label>
                <input
                  type="email" id="contact-email" name="email" required
                  class="w-full px-4 py-2.5 bg-white border border-border-light rounded-lg text-dark-bg text-sm placeholder-muted focus:border-primary focus:ring-1 focus:ring-primary transition-colors"
                />
              </div>

              <!-- Phone -->
              <div>
                <label for="contact-phone" class="block text-sm font-medium text-dark-bg mb-1.5">
                  {t.contact.form.phone}
                </label>
                <input
                  type="tel" id="contact-phone" name="phone"
                  class="w-full px-4 py-2.5 bg-white border border-border-light rounded-lg text-dark-bg text-sm placeholder-muted focus:border-primary focus:ring-1 focus:ring-primary transition-colors"
                />
              </div>

              <!-- Company -->
              <div>
                <label for="contact-company" class="block text-sm font-medium text-dark-bg mb-1.5">
                  {t.contact.form.company}
                </label>
                <input
                  type="text" id="contact-company" name="company"
                  class="w-full px-4 py-2.5 bg-white border border-border-light rounded-lg text-dark-bg text-sm placeholder-muted focus:border-primary focus:ring-1 focus:ring-primary transition-colors"
                />
              </div>
            </div>

            <!-- Subject -->
            <div>
              <label for="contact-subject" class="block text-sm font-medium text-dark-bg mb-1.5">
                {t.contact.form.subject}
              </label>
              <select
                id="contact-subject" name="form_subject"
                class="w-full px-4 py-2.5 bg-white border border-border-light rounded-lg text-dark-bg text-sm focus:border-primary focus:ring-1 focus:ring-primary transition-colors"
              >
                {subjects.map(([key, label]) => (
                  <option value={key}>{label}</option>
                ))}
              </select>
            </div>

            <!-- Product -->
            <div>
              <label for="contact-product" class="block text-sm font-medium text-dark-bg mb-1.5">
                {t.contact.form.product}
              </label>
              <select
                id="contact-product" name="product"
                class="w-full px-4 py-2.5 bg-white border border-border-light rounded-lg text-dark-bg text-sm focus:border-primary focus:ring-1 focus:ring-primary transition-colors"
              >
                <option value="">{t.contact.form.selectProduct}</option>
                {CATEGORY_KEYS.map((key) => (
                  <option value={key}>{categories[key]?.name}</option>
                ))}
              </select>
            </div>

            <!-- Message -->
            <div>
              <label for="contact-message" class="block text-sm font-medium text-dark-bg mb-1.5">
                {t.contact.form.message} <span class="text-primary">*</span>
              </label>
              <textarea
                id="contact-message" name="message" rows={5} required
                class="w-full px-4 py-2.5 bg-white border border-border-light rounded-lg text-dark-bg text-sm placeholder-muted focus:border-primary focus:ring-1 focus:ring-primary transition-colors resize-y"
              ></textarea>
            </div>

            <!-- Submit -->
            <button
              type="submit" id="contact-submit-btn"
              class="w-full py-3 px-6 bg-primary hover:bg-primary-dark text-white font-semibold rounded-lg transition-colors duration-200 flex items-center justify-center gap-2"
            >
              {t.contact.form.submit}
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </button>

            <!-- Success Message -->
            <div id="contact-success" class="hidden p-4 bg-green-50 border border-green-200 text-green-800 rounded-xl text-sm">
              {t.contact.form.success}
            </div>

            <!-- Error Message -->
            <div id="contact-error" class="hidden p-4 bg-red-50 border border-red-200 text-red-800 rounded-xl text-sm">
              {t.contact.form.error}
            </div>
          </form>
        </div>

        <!-- Contact Info Sidebar (2 cols) -->
        <div class="lg:col-span-2 space-y-6">
          {[
            { icon: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z', label: t.contact.info.address, value: t.contact.info.addressValue },
            { icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z', label: t.contact.info.phone, value: t.contact.info.phoneValue },
            { icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z', label: t.contact.info.email, value: t.contact.info.emailValue },
            { icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z', label: t.contact.info.workingHours, value: t.contact.info.workingHoursValue },
          ].map((info, i) => (
            <div class:list={['glass-card rounded-xl p-5 flex items-start gap-4 hover:border-primary/20 transition-all duration-300 animate-fade-in-up', delays[i] || '']}>
              <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d={info.icon} />
                </svg>
              </div>
              <div>
                <div class="text-xs font-mono text-muted uppercase tracking-wider mb-1">{info.label}</div>
                <div class="text-dark-bg text-sm font-medium text-left rtl:text-right">
                  <bdi dir="ltr">{info.value}</bdi>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline src="/js/form-config.js"></script>
<script is:inline src="/js/form-handler.js"></script>
