---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Locale, getTranslations, CATEGORY_KEYS } from '../../i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'tr' } },
    { params: { lang: 'en' } },
    { params: { lang: 'ar' } },
  ];
}

const { lang } = Astro.params;
const locale = lang as Locale;
const t = getTranslations(locale);
const categories = t.products.categories as Record<string, { name: string; description: string }>;
const specs = t.technicalData.specs;
const materials = t.technicalData.materials;
const delays = ['animate-delay-100', 'animate-delay-200', 'animate-delay-300', 'animate-delay-400'];

// Sample spec data for display
const specRows = [
  { category: 'radiatorCores', material: materials.copper + ' / ' + materials.aluminum, dims: '300–800mm', weight: '2–15 kg', capacity: '5–40 L', pressure: '1.5–3.0 bar', temp: '-40 ~ 120°C' },
  { category: 'fullRadiators', material: materials.aluminum, dims: '400–900mm', weight: '5–25 kg', capacity: '8–50 L', pressure: '1.5–2.5 bar', temp: '-40 ~ 120°C' },
  { category: 'intercoolers', material: materials.aluminum, dims: '200–600mm', weight: '3–12 kg', capacity: '2–15 L', pressure: '2.0–4.0 bar', temp: '-40 ~ 200°C' },
  { category: 'oilCoolers', material: materials.aluminum + ' / ' + materials.steel, dims: '150–400mm', weight: '1–8 kg', capacity: '0.5–5 L', pressure: '5.0–15.0 bar', temp: '-30 ~ 150°C' },
  { category: 'industrialCoolers', material: materials.copper + ' / ' + materials.brass, dims: '500–1500mm', weight: '20–100 kg', capacity: '30–200 L', pressure: '2.0–5.0 bar', temp: '-40 ~ 150°C' },
];
---

<BaseLayout
  title={t.technicalData.pageTitle}
  description={t.technicalData.pageDescription}
  locale={locale}
  canonicalPath="/technical-data"
>
  <!-- Page Header -->
  <section class="py-16 md:py-24 bg-cream relative overflow-hidden">
    <div class="absolute top-0 left-0 w-80 h-80 bg-primary/5 rounded-full blur-3xl -translate-y-1/3 -translate-x-1/3"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading text-dark-bg mb-4 animate-fade-in-up">{t.technicalData.heading}</h1>
      <p class="text-muted text-base md:text-lg max-w-2xl mx-auto animate-fade-in-up animate-delay-100">{t.technicalData.subheading}</p>
    </div>
  </section>

  <!-- Materials Section -->
  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-5xl md:text-6xl font-heading text-dark-bg text-center mb-12">{materials.title}</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
        {[
          { name: materials.copper, symbol: 'Cu' },
          { name: materials.aluminum, symbol: 'Al' },
          { name: materials.brass, symbol: 'CuZn' },
          { name: materials.steel, symbol: 'Fe' },
        ].map((mat, i) => (
          <div class:list={['glass-card rounded-2xl p-6 text-center hover:border-primary/30 transition-all duration-300 animate-fade-in-up', delays[i] || '']}>
            <div class="text-2xl md:text-3xl font-mono text-primary mb-2">{mat.symbol}</div>
            <div class="text-sm text-dark-bg font-medium">{mat.name}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Specifications Table -->
  <section class="py-16 md:py-24 bg-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-5xl md:text-6xl font-heading text-dark-bg text-center mb-12">{specs.title}</h2>
      <div class="overflow-x-auto rounded-2xl border border-border-light">
        <table class="w-full text-sm" id="specs-table">
          <thead>
            <tr class="bg-primary text-white">
              <th class="px-4 py-3 text-start font-semibold font-body">{specs.material}</th>
              <th class="px-4 py-3 text-start font-semibold font-body">{specs.dimensions}</th>
              <th class="px-4 py-3 text-start font-semibold font-body">{specs.weight}</th>
              <th class="px-4 py-3 text-start font-semibold font-body">{specs.capacity}</th>
              <th class="px-4 py-3 text-start font-semibold font-body">{specs.pressure}</th>
              <th class="px-4 py-3 text-start font-semibold font-body">{specs.temperature}</th>
            </tr>
          </thead>
          <tbody>
            {specRows.map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-cream'}>
                <td class="px-4 py-3 font-medium text-dark-bg">
                  <div class="text-xs text-primary font-mono mb-0.5">{categories[row.category]?.name}</div>
                  {row.material}
                </td>
                <td class="px-4 py-3 text-dark-mid/70">{row.dims}</td>
                <td class="px-4 py-3 text-dark-mid/70">{row.weight}</td>
                <td class="px-4 py-3 text-dark-mid/70">{row.capacity}</td>
                <td class="px-4 py-3 text-dark-mid/70">{row.pressure}</td>
                <td class="px-4 py-3 text-dark-mid/70">{row.temp}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>


    </div>
  </section>
</BaseLayout>
