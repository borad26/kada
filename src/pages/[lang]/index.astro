---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlaceholderImage from '../../components/PlaceholderImage.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { type Locale, getTranslations, localizedPath, CATEGORY_KEYS } from '../../i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'tr' } },
    { params: { lang: 'en' } },
    { params: { lang: 'ar' } },
  ];
}

const { lang } = Astro.params;
const locale = lang as Locale;
const t = getTranslations(locale);
const categories = t.products.categories as Record<string, { name: string; description: string }>;

const stats = [
  { target: 43, suffix: '', suffixAtEnd: false, label: t.stats.years },
  { target: 35, suffix: '', suffixAtEnd: false, label: t.stats.countries },
  { target: 500, suffix: '+', suffixAtEnd: true, label: t.stats.dealers },
  { target: 3, suffix: 'M+', suffixAtEnd: false, label: t.stats.units },
];

// Category icon map
const categoryIcons: Record<string, string> = {
  radiatorCores: 'radiator',
  fullRadiators: 'radiator',
  intercoolers: 'cooler',
  oilCoolers: 'cooler',
  acRadiators: 'cooler',
  industrialCoolers: 'factory',
  heaters: 'radiator',
  aftercoolers: 'cooler',
};

const iconsData: Record<string, string> = {
  radiator: 'M4 4h16v2H4V4zm0 14h16v2H4v-2zm2-10h2v8H6V8zm4 0h2v8h-2V8zm4 0h2v8h-2V8zm4 0h2v8h-2V8z',
  cooler: 'M12 3v18m-6-6l6 6 6-6M4 8h16M8 5v3m8-3v3',
  factory: 'M4 21V10l4-3v3l4-3v3l4-3v3l4-3v11H4zm2-2h2v-3H6v3zm4 0h2v-3h-2v3zm4 0h2v-3h-2v3z',
};

const categoryFilterMap: Record<string, string> = {
  radiatorCores: 'petek-grubu',
  fullRadiators: 'kamyonet-kamyon',
  oilCoolers: 'yag-radyatoru',
  acRadiators: 'klima-grubu',
  industrialCoolers: 'is-makinalari',
  heaters: 'kalorifer-grubu',
  aftercoolers: 'ozel-imalat',
};

const delays = ['animate-delay-100', 'animate-delay-200', 'animate-delay-300'];
---

<BaseLayout
  title={t.site.pageTitle}
  description={t.site.pageDescription}
  locale={locale}
  canonicalPath=""
>
  <!-- ══════════════════════════════════════════════════ -->
  <!-- HERO SECTION                                     -->
  <!-- ══════════════════════════════════════════════════ -->
  <section class="relative bg-cream overflow-hidden min-h-[85vh] flex items-center">
    <!-- Subtle grid pattern overlay -->
    <div class="absolute inset-0 opacity-5">
      <div class="absolute inset-0 bg-grid-pattern"></div>
    </div>

    <!-- Green accent glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 flex flex-col md:flex-row-reverse items-center gap-8 lg:gap-16 z-10">
      
      <!-- Right Column (Image) - Moved to top of DOM for mobile -->
      <div class="w-full md:flex-1 relative h-48 md:h-[400px] lg:h-[550px] animate-fade-in-up animate-delay-200">
        <div class="absolute inset-0 overflow-hidden rounded-2xl shadow-2xl group" id="hero-slideshow">
          <img 
            src="/bakir.jpg" 
            alt="KADA bakır radyatör üretimi" 
            class="hero-slide absolute inset-0 w-full h-full object-cover transition-all duration-700 ease-in-out group-hover:scale-105 opacity-100"
            width="1200"
            height="800"
            sizes="(max-width: 768px) 100vw, 50vw"
            fetchpriority="high"
            loading="eager"
          />
          <img 
            src="/kaynak.avif" 
            alt="KADA üretim - kaynak işlemi" 
            class="hero-slide absolute inset-0 w-full h-full object-cover transition-all duration-700 ease-in-out group-hover:scale-105 opacity-0"
            width="1200"
            height="800"
            sizes="(max-width: 768px) 100vw, 50vw"
            loading="lazy"
          />
          <img 
            src="/calisan.jpg" 
            alt="KADA üretim ekibi" 
            class="hero-slide absolute inset-0 w-full h-full object-cover transition-all duration-700 ease-in-out group-hover:scale-105 opacity-0"
            width="1200"
            height="800"
            sizes="(max-width: 768px) 100vw, 50vw"
            loading="lazy"
          />
          <!-- Slight dark green tint overlay -->
          <div class="absolute inset-0 bg-[#0D6830] opacity-10 pointer-events-none z-10"></div>
        </div>
      </div>

      <!-- Left Column (Text) -->
      <div class="flex-1 w-full text-left md:pl-16 lg:pl-0">
        <!-- Label badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-primary/20 bg-primary/10 mb-4 animate-hero-fade" style="animation-delay: 0ms;">
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          <span class="text-xs font-mono text-primary tracking-wider uppercase">{t.site.tagline}</span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-heading text-dark-bg leading-[1.1] mb-5 flex flex-col gap-1 md:gap-2">
          <div class="animate-hero-fade" style="animation-delay: 0ms;">{t.hero.titleLine1}</div>
          <div class="animate-hero-fade text-[#0D6830]" style="animation-delay: 200ms;">{t.hero.titleLine2}</div>
        </h1>

        <!-- Subtitle -->
        <p class="text-base md:text-lg text-muted max-w-xl mb-8 leading-relaxed animate-hero-fade" style="animation-delay: 400ms;">
          {t.hero.subtitle}
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col gap-3 sm:flex-row animate-hero-fade" style="animation-delay: 600ms;">
          <a
            href={localizedPath('/products', locale)}
            class="w-full sm:w-auto px-8 py-3.5 bg-primary hover:bg-primary-dark text-white font-semibold rounded-xl transition-all duration-200 hover:shadow-lg hover:shadow-primary/20 text-center"
            id="hero-cta-products"
          >
            {t.hero.cta}
          </a>
          <a
            href={localizedPath('/contact', locale)}
            class="w-full sm:w-auto px-8 py-3.5 border border-dark-bg text-dark-bg hover:border-primary hover:text-primary rounded-xl transition-all duration-200 text-center"
            id="hero-cta-quote"
          >
            {t.hero.ctaSecondary}
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom fade -->
    <div class="absolute bottom-0 inset-x-0 h-32 bg-gradient-to-t from-cream to-transparent z-20 pointer-events-none"></div>

    <!-- Stats Strip -->
    <div class="absolute bottom-0 left-0 right-0 z-30 bg-dark-bg border-t border-border-dark" id="hero-stats-strip">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 py-2 md:py-4">
          {stats.map((stat, i) => (
            <div class:list={[
              'flex flex-col items-center justify-center py-4 md:py-0',
              i < 3 ? 'md:border-e border-border-dark' : '',
              i < 2 ? 'border-b md:border-b-0 border-border-dark' : ''
            ]}>
              <span 
                class="text-4xl md:text-5xl font-heading font-bold text-primary leading-none mb-1 stat-number"
                data-target={stat.target}
                data-suffix={stat.suffix}
                data-suffix-at-end={stat.suffixAtEnd ? 'true' : 'false'}
              >
                0{stat.suffixAtEnd ? '' : stat.suffix}
              </span>
              <span class="text-[10px] md:text-xs font-mono text-muted uppercase tracking-[0.2em] text-center px-2">
                {stat.label}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════ -->
  <!-- PRODUCT CATEGORIES PREVIEW                       -->
  <!-- ══════════════════════════════════════════════════ -->
  <section class="py-16 md:py-24 bg-cream below-fold-section">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 md:mb-16">
        <h2 class="text-5xl md:text-6xl font-heading text-dark-bg mb-4">{t.products.heading}</h2>
        <p class="text-dark-mid/70 text-base md:text-lg max-w-2xl mx-auto">{t.products.subheading}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {CATEGORY_KEYS.map((key, i) => (
          <a href={`${localizedPath('/products', locale)}?category=${categoryFilterMap[key] || ''}`} class:list={['group block animate-fade-in-up cursor-pointer bg-white rounded-2xl shadow-sm hover:shadow-md transition-all duration-200 hover:-translate-y-1 p-6 md:p-8', delays[i % 3] || '']}>
            <div class="flex flex-col items-center text-center">
              <div class="w-[72px] h-[72px] shrink-0 bg-primary rounded-full flex items-center justify-center mb-5 transition-transform duration-300 group-hover:scale-110">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path d={iconsData[categoryIcons[key]] || iconsData.radiator} />
                </svg>
              </div>
              <h3 class="text-xl font-bold text-dark-bg transition-colors duration-300 group-hover:text-primary font-body mb-3">{categories[key]?.name}</h3>
              <p class="text-sm text-muted leading-relaxed">{categories[key]?.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════ -->
  <!-- TESTIMONIALS                                     -->
  <!-- ══════════════════════════════════════════════════ -->
  {/* TODO: unhide when real references available
  <section class="py-16 md:py-24 bg-dark-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-5xl md:text-6xl font-heading text-white mb-4">{t.testimonials.title}</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
        {t.testimonials.items.map((item, i) => (
          <div class:list={['glass-card rounded-2xl p-6 md:p-8 hover:border-primary/20 transition-all duration-300 animate-fade-in-up', delays[i] || '']}>
            <!-- Quote icon -->
            <svg class="w-8 h-8 text-primary/30 mb-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
            </svg>
            <p class="text-text-light text-sm md:text-base leading-relaxed mb-6">"{item.text}"</p>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center">
                <span class="text-primary font-semibold text-sm">{item.name.charAt(0)}</span>
              </div>
              <div>
                <p class="text-white font-medium text-sm">{item.name}</p>
                <p class="text-muted text-xs font-mono">{item.company}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  */}

  <!-- ══════════════════════════════════════════════════ -->
  <!-- QUOTE CTA                                         -->
  <!-- ══════════════════════════════════════════════════ -->
  <QuoteForm locale={locale} />
</BaseLayout>

<style is:global>
  @keyframes heroFadeUp {
    0% {
      opacity: 0;
      transform: translateY(20px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-hero-fade {
    opacity: 0;
    animation: heroFadeUp 600ms ease-out forwards;
  }
</style>

<script>
  function animateCountUp(el: HTMLElement) {
    const target = parseInt(el.dataset.target || '0', 10);
    const suffix = el.dataset.suffix || '';
    const suffixAtEnd = el.dataset.suffixAtEnd === 'true';
    const duration = 1500;
    const startTime = performance.now();

    function update(now: number) {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      
      // Ease-out cubic
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = Math.round(eased * target);

      let text = current.toString();
      if (!suffixAtEnd || progress === 1) {
        text += suffix;
      }
      
      el.textContent = text;

      if (progress < 1) {
        requestAnimationFrame(update);
      }
    }

    requestAnimationFrame(update);
  }

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const numbers = entry.target.querySelectorAll<HTMLElement>('.stat-number');
          numbers.forEach((el) => animateCountUp(el));
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  const strip = document.getElementById('hero-stats-strip');
  if (strip) observer.observe(strip);

  // Hero Slideshow
  const slides = document.querySelectorAll('.hero-slide');
  if (slides.length > 0) {
    let currentSlide = 0;
    setInterval(() => {
      slides[currentSlide].classList.remove('opacity-100');
      slides[currentSlide].classList.add('opacity-0');
      
      currentSlide = (currentSlide + 1) % slides.length;
      
      slides[currentSlide].classList.remove('opacity-0');
      slides[currentSlide].classList.add('opacity-100');
    }, 4000);
  }
</script>
