---
import BaseLayout from '../../layouts/BaseLayout.astro';

import { type Locale, getTranslations, localizedPath } from '../../i18n';
import ProductCard from '../../components/ProductCard.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'tr' } },
    { params: { lang: 'en' } },
    { params: { lang: 'ar' } },
  ];
}

const { lang } = Astro.params;
const locale = lang as Locale;
const t = getTranslations(locale);

import { ALL_PRODUCTS, getCategoryMap } from '../../data/products';

const categoryMap = getCategoryMap(locale);

// SEO: Build dynamic keyword string from products
const seoKeywords = [...new Set(ALL_PRODUCTS.flatMap(p => [p.brand, p.name, p.oem, p.code]))].join(', ');
---

<BaseLayout
  title={t.products.pageTitle}
  description={t.products.pageDescription}
  locale={locale}
  canonicalPath="/products"
>
  <Fragment slot="head">
    <meta name="keywords" content={seoKeywords} />
  </Fragment>

<div class="bg-cream min-h-screen">
  <!-- Page Header -->
  <section class="pt-16 md:pt-24 pb-8 md:pb-10 relative overflow-hidden">
    <div class="absolute top-0 right-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading text-dark-bg mb-4 animate-fade-in-up">{t.products.heading}</h1>
      <p class="text-muted text-base md:text-lg max-w-2xl mx-auto animate-fade-in-up animate-delay-100">{t.products.subheading}</p>
    </div>
  </section>

  <!-- Search + Filter Bar -->
  <section class="pb-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl shadow-sm p-4 md:p-6 border border-[#E0DDD7]">
        <div class="flex flex-col md:flex-row gap-4">
          <!-- Search Input -->
          <div class="flex-1 relative">
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-muted pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              id="product-search"
              placeholder={t.products?.searchPlaceholder || "OEM kodu, ürün kodu veya marka ile arayın..."}
              class="w-full pl-12 pr-4 py-3 bg-[#F9F8F6] border border-[#E0DDD7] rounded-xl text-dark-bg text-sm placeholder-muted focus:border-primary focus:ring-1 focus:ring-primary transition-colors outline-none"
            />
          </div>
          <!-- Category Filter -->
          <div class="md:w-64">
            <select
              id="category-filter"
              class="w-full px-4 py-3 bg-[#F9F8F6] border border-[#E0DDD7] rounded-xl text-dark-bg text-sm focus:border-primary focus:ring-1 focus:ring-primary transition-colors outline-none appearance-none cursor-pointer"
              style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2220%22 height=%2220%22 viewBox=%220 0 24 24%22 fill=%22none%22 stroke=%22%239CA3AF%22 stroke-width=%222%22><path d=%22M6 9l6 6 6-6%22/></svg>'); background-repeat: no-repeat; background-position: right 12px center;"
            >
              <option value="all">{t.products?.allCategories || "Tüm Kategoriler"}</option>
              {Object.entries(categoryMap).map(([key, label]) => (
                <option value={key}>{label}</option>
              ))}
            </select>
          </div>
        </div>
        <!-- Result Counter -->
        <div class="mt-3 flex items-center justify-between">
          <p class="text-xs text-muted" id="result-count">
            {t.products?.productsListed?.split('{count}')[0] || ''}<span class="font-semibold text-dark-bg" id="count-number">{ALL_PRODUCTS.length}</span>{t.products?.productsListed?.split('{count}')[1] || ' ürün listeleniyor'}
          </p>
          <button id="clear-filters" class="text-xs text-primary hover:text-primary-dark font-semibold transition-colors hidden">
            Filtreleri Temizle
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Product Grid -->
  <section class="pb-16 md:pb-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- No Results State -->
      <div id="no-results" class="hidden text-center py-16">
        <svg class="w-16 h-16 mx-auto text-muted/40 mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <h3 class="text-xl font-bold text-dark-bg mb-2">Sonuç Bulunamadı</h3>
        <p class="text-muted text-sm">Arama kriterlerinizi değiştirmeyi deneyin.</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3 sm:gap-5 md:gap-6" id="product-grid">
        {ALL_PRODUCTS.map((product) => (
          <ProductCard product={product} locale={locale} />
        ))}
      </div>
    </div>
  </section>
</div>


</BaseLayout>

<script>
  const searchInput = document.getElementById('product-search') as HTMLInputElement;
  const categoryFilter = document.getElementById('category-filter') as HTMLSelectElement;
  const productGrid = document.getElementById('product-grid')!;
  const countNumber = document.getElementById('count-number')!;
  const noResults = document.getElementById('no-results')!;
  const clearBtn = document.getElementById('clear-filters')!;
  const cards = Array.from(productGrid.querySelectorAll<HTMLElement>('.product-card'));

  function filterProducts() {
    const query = searchInput.value.toLowerCase().trim();
    const category = categoryFilter.value;
    let visibleCount = 0;

    cards.forEach((card) => {
      const name = card.dataset.name || '';
      const brand = card.dataset.brand || '';
      const oem = card.dataset.oem || '';
      const code = card.dataset.code || '';
      const cat = card.dataset.category || '';

      const matchesSearch = !query ||
        name.includes(query) ||
        brand.includes(query) ||
        oem.includes(query) ||
        code.includes(query);

      const matchesCategory = category === 'all' || cat === category;

      if (matchesSearch && matchesCategory) {
        card.style.display = '';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    countNumber.textContent = visibleCount.toString();
    noResults.classList.toggle('hidden', visibleCount > 0);
    productGrid.classList.toggle('hidden', visibleCount === 0);
    clearBtn.classList.toggle('hidden', !query && category === 'all');
  }

  searchInput.addEventListener('input', filterProducts);
  categoryFilter.addEventListener('change', filterProducts);

  clearBtn.addEventListener('click', () => {
    searchInput.value = '';
    categoryFilter.value = 'all';
    filterProducts();
  });

  // Check URL params for pre-selected category
  const urlParams = new URLSearchParams(window.location.search);
  const preCategory = urlParams.get('category');
  if (preCategory && categoryFilter.querySelector(`option[value="${preCategory}"]`)) {
    categoryFilter.value = preCategory;
    filterProducts();
  }
</script>
