---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlaceholderImage from '../../components/PlaceholderImage.astro';
import SimpleCTA from '../../components/SimpleCTA.astro';
import { type Locale, getTranslations } from '../../i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'tr' } },
    { params: { lang: 'en' } },
    { params: { lang: 'ar' } },
  ];
}

const { lang } = Astro.params;
const locale = lang as Locale;
const t = getTranslations(locale);

const values = [
  { ...t.about.values.quality, icon: 'shield' },
  { ...t.about.values.innovation, icon: 'chart' },
  { ...t.about.values.trust, icon: 'factory' },
  { ...t.about.values.global, icon: 'globe' },
];
const delays = ['animate-delay-100', 'animate-delay-200', 'animate-delay-300', 'animate-delay-400'];

const iconsData: Record<string, string> = {
  shield: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  chart: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6',
  factory: 'M4 21V10l4-3v3l4-3v3l4-3v3l4-3v11H4zm2-2h2v-3H6v3zm4 0h2v-3h-2v3zm4 0h2v-3h-2v3z',
  globe: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9'
};
---

<BaseLayout
  title={t.about.pageTitle}
  description={t.about.pageDescription}
  locale={locale}
  canonicalPath="/about"
>
<div class="bg-cream min-h-screen">
  <!-- Page Header -->
  <section class="pt-16 md:pt-24 pb-8 md:pb-12 relative overflow-hidden">
    <div class="absolute bottom-0 left-0 w-80 h-80 bg-primary/5 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading text-dark-bg mb-4 animate-fade-in-up">{t.about.heading}</h1>
    </div>
  </section>

  <!-- Story Section -->
  <section class="pb-16 md:pb-24 pt-8 md:pt-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-3xl p-8 md:p-12 shadow-sm grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="animate-fade-in-up h-full">
          <img src="/469_69992-959x580.jpg" alt="KADA Oto Radyatör Fabrika Binası - 7000 m² Entegre Üretim Tesisleri İstanbul" class="w-full h-full object-cover rounded-2xl shadow-md" />
        </div>
        <div class="space-y-6">
          <h2 class="text-3xl md:text-4xl font-heading text-dark-bg animate-fade-in-up">{t.about.story.title}</h2>
          <p class="text-muted leading-relaxed animate-fade-in-up animate-delay-100">{t.about.story.p1}</p>
          <p class="text-muted leading-relaxed animate-fade-in-up animate-delay-200">{t.about.story.p2}</p>
          <p class="text-muted leading-relaxed animate-fade-in-up animate-delay-300">{t.about.story.p3}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Values Section -->
  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-[#1A1E1B] rounded-3xl p-10 md:p-16 shadow-lg">
        <h2 class="text-5xl md:text-6xl font-heading text-[#ECECEC] text-center mb-12 md:mb-16">{t.about.values.title}</h2>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 sm:gap-x-12 gap-y-12 sm:gap-y-16">
          {values.map((val, i) => (
            <div class:list={['flex flex-col items-center text-center animate-fade-in-up', delays[i] || '']}>
              <div class="w-[88px] h-[88px] shrink-0 bg-primary rounded-full flex items-center justify-center mb-6">
                <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path d={iconsData[val.icon] || iconsData.shield} stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
              <h3 class="text-xl font-bold text-[#ECECEC] mb-3 font-body">{val.title}</h3>
              <p class="text-sm text-[#8A9490] leading-relaxed max-w-[240px]">{val.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-br from-white via-[#F9F8F6] to-white rounded-3xl p-10 md:p-16 border border-primary/5 relative overflow-hidden shadow-sm">
        <div class="absolute inset-0" style="background-image: radial-gradient(rgba(13, 104, 48, 0.04) 2px, transparent 2px); background-size: 24px 24px;"></div>
        <div class="relative z-10">
          <h2 class="text-5xl md:text-6xl font-heading text-dark-bg text-center mb-16">{t.about.process.title}</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {t.about.process.steps.map((step: any, i: number) => (
              <div class:list={[
                'flex flex-col items-center text-center p-4 md:p-8 bg-white/60 backdrop-blur-md rounded-2xl border border-[#E0DDD7] animate-fade-in-up hover:-translate-y-1 hover:shadow-lg shadow-sm transition-all duration-300',
                delays[i] || ''
              ]}>
                <div class="text-[#0D6830] font-heading text-5xl md:text-7xl lg:text-8xl mb-4 font-bold tracking-widest">
                  0{i + 1}
                </div>
                <h3 class="text-xl font-bold text-dark-bg mb-3 font-body">{step.title}</h3>
                <p class="text-sm text-muted leading-relaxed">{step.description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Factory Section -->
  <section class="py-12 md:py-16 mb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-[#1A1E1B] rounded-3xl p-10 md:p-16 shadow-lg">
        <h2 class="text-5xl md:text-6xl font-heading text-[#ECECEC] text-center mb-16">{t.about.factory.title}</h2>
        <div class="flex flex-col items-center gap-12" id="factory-section">
          <!-- Stat Cards -->
          <div class="flex flex-col md:flex-row justify-center items-center gap-8 w-full">
            {t.about.factory.stats.slice(0, 2).map((stat: any, i: number) => (
              <div class:list={['bg-[#232824] border border-[rgba(255,255,255,0.07)] rounded-2xl p-8 md:p-10 flex flex-col items-center justify-center text-center animate-fade-in-up w-[280px]', delays[i] || '']}>
                <div class="font-heading text-5xl text-[#0D6830] mb-4 about-stat-number" data-original={stat.value}>
                  0
                </div>
                <div class="text-sm uppercase tracking-wider text-[#8A9490] font-semibold">
                  {stat.label}
                </div>
              </div>
            ))}
          </div>

          <!-- Google Maps Embed -->
          <div class="w-full max-w-[800px] mx-auto animate-fade-in-up animate-delay-200">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3010.892!2d28.816!3d41.058!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14caa500e9441923%3A0xe7ac2efac42fb45a!2sKADA%20Oto%20Radyat%C3%B6r!5e0!3m2!1str!2str!4v1717000000000!5m2!1str!2str"
              width="100%"
              height="350"
              style="border:0; border-radius: 16px;"
              allowfullscreen=""
              loading="lazy">
            </iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

</div>
  <!-- Simple CTA -->
  <SimpleCTA locale={locale} />
</BaseLayout>

<script>
  function animateAboutCountUp(el: HTMLElement) {
    const original = el.dataset.original;
    if (!original) return;
    
    const numMatch = original.match(/\d+/g);
    if (!numMatch) return;
    
    const target = parseInt(numMatch.join(''), 10);
    const suffixActual = original.replace(/[\d.,]/g, '');
    
    const duration = 2000;
    const startTime = performance.now();
    
    function update(now: number) {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = Math.round(eased * target);
      
      let text = current.toString();
      if (target >= 1000 && current >= 1000) {
        text = text.replace(/\B(?=(\d{3})+(?!\d))/g, ".");
      }
      
      if (progress < 1) {
        el.textContent = text + suffixActual;
        requestAnimationFrame(update);
      } else {
        el.textContent = original;
      }
    }
    
    requestAnimationFrame(update);
  }

  const aboutObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const numbers = entry.target.querySelectorAll<HTMLElement>('.about-stat-number');
          numbers.forEach((el) => animateAboutCountUp(el));
          aboutObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  const factorySection = document.getElementById('factory-section');
  if (factorySection) aboutObserver.observe(factorySection);
</script>
