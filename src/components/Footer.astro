---
import { type Locale, getTranslations, getNavLinks, localizedPath, isRTL } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const navLinks = getNavLinks(locale);
const rtl = isRTL(locale);
const year = new Date().getFullYear();
---

<footer class="bg-dark-mid border-t border-border-dark">
  <!-- Main footer content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">

      <!-- Brand Column -->
      <div class="lg:col-span-1">
        <a href={localizedPath('/', locale)} class="flex items-center gap-2 mb-4 group">
          <img src="/logo.png" alt="KADA Logo" class="h-10 w-auto object-contain" />
        </a>
        <p class="text-muted text-sm leading-relaxed">{t.footer.description}</p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">{t.footer.quickLinks}</h3>
        <ul class="space-y-2">
          {navLinks.slice(0, 6).map((link) => (
            <li>
              <a href={link.href} class="text-muted text-sm hover:text-primary transition-colors duration-200">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- More Links -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">&nbsp;</h3>
        <ul class="space-y-2">
          {navLinks.slice(6).map((link) => (
            <li>
              <a href={link.href} class="text-muted text-sm hover:text-primary transition-colors duration-200">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">{t.footer.contactInfo}</h3>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="text-muted text-sm text-left rtl:text-right">
              <bdi dir="ltr">{t.footer.address}</bdi>
            </span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:info@kadaradiator.com" class="text-muted text-sm hover:text-primary transition-colors text-left rtl:text-right">
              <bdi dir="ltr">info@kadaradiator.com</bdi>
            </a>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span class="text-muted text-sm text-left rtl:text-right">
              <bdi dir="ltr">+90 212 657 97 70</bdi>
            </span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-border-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-muted text-xs">
        &copy; {year} KADA Oto Radyatör. {t.footer.rights}
      </p>
      <div class="flex items-center gap-4">
        <a href={localizedPath('/', locale)} class="text-muted text-xs hover:text-primary transition-colors">TR</a>
        <span class="text-border-dark">|</span>
        <a href="/en" class="text-muted text-xs hover:text-primary transition-colors">EN</a>
        <span class="text-border-dark">|</span>
        <a href="/ar" class="text-muted text-xs hover:text-primary transition-colors">AR</a>
      </div>
    </div>
  </div>
</footer>
