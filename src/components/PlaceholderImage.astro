---
/**
 * PlaceholderImage — displays a styled placeholder with SVG icon.
 * Swap with a real <img> tag when photos become available.
 */
interface Props {
  variant?: 'dark' | 'light';
  icon?: 'radiator' | 'cooler' | 'factory' | 'shield' | 'globe' | 'chart' | 'question' | 'mail';
  alt: string;
  class?: string;
}

const { variant = 'dark', icon = 'radiator', alt, class: className = '' } = Astro.props;

const bgColor = variant === 'dark' ? 'bg-dark-mid' : 'bg-border-light';
const iconColor = variant === 'dark' ? 'text-muted/40' : 'text-dark-mid/30';

// SVG paths for each icon type
const icons: Record<string, string> = {
  radiator: 'M4 4h16v2H4V4zm0 14h16v2H4v-2zm2-10h2v8H6V8zm4 0h2v8h-2V8zm4 0h2v8h-2V8zm4 0h2v8h-2V8z',
  cooler: 'M12 3v18m-6-6l6 6 6-6M4 8h16M8 5v3m8-3v3',
  factory: 'M4 21V10l4-3v3l4-3v3l4-3v3l4-3v11H4zm2-2h2v-3H6v3zm4 0h2v-3h-2v3zm4 0h2v-3h-2v3z',
  shield: 'M12 2l8 4v6c0 5.25-3.44 10.08-8 11.56C7.44 22.08 4 17.25 4 12V6l8-4zm-1 9H7.5a8.3 8.3 0 004.5 7.5V11zm2 7.5A8.3 8.3 0 0016.5 11H13v7.5z',
  globe: 'M12 2a10 10 0 100 20 10 10 0 000-20zm0 2a8 8 0 016.32 3.1A12.97 12.97 0 0012 6a12.97 12.97 0 00-6.32 1.1A8 8 0 0112 4zm0 16a8 8 0 01-6.32-3.1A12.97 12.97 0 0012 18a12.97 12.97 0 006.32-1.1A8 8 0 0112 20zM2.46 12H6a10.97 10.97 0 016-5.39A10.97 10.97 0 0018 12h3.54',
  chart: 'M4 20h16M4 20V4m4 16V10m4 10V6m4 10v-4m4 4V8',
  question: 'M12 2a10 10 0 100 20 10 10 0 000-20zm0 14.5a1 1 0 110 2 1 1 0 010-2zm1-2.5h-2a3 3 0 013-3 1 1 0 10-1-1h-2a3 3 0 116 0c0 1.3-.84 2.4-2 2.82V14z',
  mail: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
};
---

<div
  class:list={[
    'w-full aspect-[4/3] rounded-xl flex items-center justify-center overflow-hidden',
    bgColor,
    className,
  ]}
  role="img"
  aria-label={alt}
>
  <svg
    class:list={['w-16 h-16 md:w-20 md:h-20', iconColor]}
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    viewBox="0 0 24 24"
  >
    <path d={icons[icon] || icons.radiator} />
  </svg>
</div>
