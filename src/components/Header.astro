---
import { type Locale, getTranslations, getNavLinks, localizedPath, isRTL } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const navLinks = getNavLinks(locale).filter(l => !l.href.includes('/network') && !l.href.includes('/technical-data'));
const rtl = isRTL(locale);
const currentPath = Astro.url.pathname;

// Extract path after locale prefix for language switching
function canonicalFromCurrent(path: string, currentLocale: Locale): string {
  const stripped = path.replace(new RegExp(`^/${currentLocale}`), '');
  return stripped || '';
}

// Language switcher links
const langLinks = [
  { code: 'tr' as Locale, label: 'TR' },
  { code: 'en' as Locale, label: 'EN' },
  { code: 'ar' as Locale, label: 'AR' },
];
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-50 bg-dark-bg transition-all duration-300"
>

  <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <a
        href={localizedPath('/', locale)}
        class="flex items-center gap-2 group"
        id="header-logo"
      >
        <img src="/logo.png" alt="KADA Logo" class="h-10 md:h-12 w-auto object-contain" />
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-1" id="desktop-nav">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'px-3 py-2 text-sm font-medium rounded-md transition-colors duration-200',
              currentPath === link.href || currentPath === link.href + '/'
                ? 'text-primary bg-primary/10'
                : 'text-text-light/70 hover:text-white hover:bg-white/5',
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Right side: Phone + Language switcher + CTA + Mobile menu -->
      <div class="flex items-center gap-3">
        <!-- Phone Number (Desktop) -->
        <div class="hidden lg:flex items-center gap-2 border-r border-border-dark pr-4 mr-1">
          <a href="tel:+902126579770" class="flex items-center gap-2 text-xs font-mono text-muted hover:text-text-light transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <bdi dir="ltr">+90 212 657 97 70</bdi>
          </a>
        </div>

        <!-- Language Switcher -->
        <div class="hidden sm:flex items-center gap-1 border border-border-dark rounded-lg p-0.5" id="lang-switcher">
          {langLinks.map((lang) => (
            <a
              href={`/${lang.code}${canonicalFromCurrent(currentPath, locale)}`}
              class:list={[
                'px-2 py-1 text-xs font-mono rounded-md transition-colors duration-200',
                lang.code === locale
                  ? 'bg-primary text-white'
                  : 'text-muted hover:text-text-light hover:bg-white/5',
              ]}
            >
              {lang.label}
            </a>
          ))}
        </div>

        <!-- CTA Button (Desktop) -->
        <a
          href={localizedPath('/contact', locale)}
          class="hidden md:inline-flex items-center gap-2 px-4 py-2 bg-primary hover:bg-primary-dark text-white text-sm font-semibold rounded-lg transition-colors duration-200"
          id="header-cta"
        >
          {t.nav.getQuote}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d={rtl ? "M19 12H5M12 5l-7 7 7 7" : "M5 12h14M12 5l7 7-7 7"} />
          </svg>
        </a>

        <!-- Mobile Menu Toggle -->
        <button
          id="mobile-menu-toggle"
          class="lg:hidden flex items-center justify-center w-10 h-10 rounded-lg hover:bg-white/10 transition-colors"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <svg class="w-6 h-6 text-text-light" id="menu-icon-open" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="w-6 h-6 text-text-light hidden" id="menu-icon-close" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden absolute top-full inset-x-0 bg-dark-bg backdrop-blur-xl"
  >
    <nav class="max-w-7xl mx-auto px-4 py-6 flex flex-col gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'px-4 py-3 text-base font-medium rounded-lg transition-colors duration-200',
            currentPath === link.href || currentPath === link.href + '/'
              ? 'text-primary bg-primary/10'
              : 'text-text-light/70 hover:text-white hover:bg-white/5',
          ]}
        >
          {link.label}
        </a>
      ))}

      <!-- Mobile Language Switcher -->
      <div class="flex items-center gap-2 px-4 pt-4 mt-2 border-t border-border-dark">
        {langLinks.map((lang) => (
          <a
            href={`/${lang.code}${canonicalFromCurrent(currentPath, locale)}`}
            class:list={[
              'px-3 py-2 text-sm font-mono rounded-lg transition-colors duration-200',
              lang.code === locale
                ? 'bg-primary text-white'
                : 'text-muted border border-border-dark hover:text-text-light',
            ]}
          >
            {lang.label}
          </a>
        ))}
      </div>

      <!-- Mobile CTA -->
      <a
        href={localizedPath('/contact', locale)}
        class="mx-4 mt-4 flex items-center justify-center gap-2 px-4 py-3 bg-primary hover:bg-primary-dark text-white font-semibold rounded-lg transition-colors duration-200"
      >
        {t.nav.getQuote}
      </a>
    </nav>
  </div>
</header>

<!-- Spacer to offset fixed header -->
<div class="h-16 md:h-20"></div>

<script>
  // Mobile menu toggle
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', !isOpen);
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
    toggle?.setAttribute('aria-expanded', String(isOpen));
  });

  // Header background on scroll
  const header = document.getElementById('site-header');
  const handleScroll = () => {
    if (window.scrollY > 40) {
      header?.classList.add('shadow-lg', 'shadow-black/20');
    } else {
      header?.classList.remove('shadow-lg', 'shadow-black/20');
    }
  };
  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();
</script>

